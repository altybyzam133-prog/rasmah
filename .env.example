# انسخ هذا الملف إلى .env وعدّل القيم / Copy this file to .env and edit the values

# المنفذ والمضيف / Port & host
PORT=3000
HOST=127.0.0.1

# مفتاح توقيع الجلسات — غيّره لقيمة عشوائية طويلة / Session signing secret — change to a long random value
SESSION_SECRET=change-this-to-a-long-random-string

# اسم المنصة الظاهر في الواجهة / Brand name shown in the UI
BRAND_NAME_AR=رسمة
BRAND_NAME_EN=Rasmah

# الحد الأقصى لحجم الصورة المرفوعة بالميجابايت / Max upload image size in MB
MAX_UPLOAD_MB=8

# لوحة الأدمن لإدارة القوالب / Admin panel for managing templates (/admin)
# اتركه فارغًا لتعطيل اللوحة / leave blank to disable the panel
ADMIN_PASSWORD=
# اقصر الوصول على هذا الجهاز فقط / restrict /admin to localhost only
ADMIN_LOCAL_ONLY=true

# بيئة التشغيل / Environment: development | production
NODE_ENV=development

# توليد/تعديل الصور بالذكاء الاصطناعي (Pollinations.ai — مجاني، بدون مفتاح)
# AI image generation/editing (Pollinations.ai — free, no key needed)
# أقصى عدد صور بالذكاء الاصطناعي لكل مستخدم يوميًا / max AI images per user per day
AI_DAILY_LIMIT=20

# إرسال كود استعادة كلمة المرور بالبريد. اتركها فارغة والكود بينطبع بسجل السيرفر
# فقط (logs/server.log) بدل الإرسال الفعلي — مفيد للتجربة المحلية.
# Sends the password-reset code by email. Leave blank and the code is just
# logged to the server (logs/server.log) instead of actually emailed — fine
# for local testing.
# مثال Gmail: أنشئ "App Password" من myaccount.google.com/apppasswords
# (كلمة مرورك العادية ما تشتغل مع 2FA) واستخدمها هنا.
# Gmail example: create an "App Password" at myaccount.google.com/apppasswords
# (your normal password won't work with 2FA enabled) and use it here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# بحث صور جاهزة (Pexels) في لوحة "صور" بالمحرر — مجاني، تسجيل فوري بدون بطاقة.
# اتركه فارغًا وتختفي لوحة البحث وتظهر رسالة إعداد بدلها.
# سجّل مفتاح مجاني من: https://www.pexels.com/api/
# Stock photo search (Pexels) in the editor's "Photos" panel — free, instant
# signup, no card. Leave blank and the panel shows a setup hint instead.
# Get a free key at: https://www.pexels.com/api/
PEXELS_API_KEY=

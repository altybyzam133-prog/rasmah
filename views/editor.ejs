          <input type="file" id="removeBgTabInput" accept="image/png,image/jpeg,image/webp" hidden>
          <span><%- icon('upload') %> <%= t('ed_upload_btn') %></span>
          <small><%= t('ed_upload_hint', { mb: config.maxUploadMb }) %></small>
        </label>
        <div class="ed-canvas-pick" id="removeBgTabCanvasPick" hidden>
          <span class="ed-glabel"><%= t('ed_pick_from_canvas') %></span>
          <div class="ed-upload-grid" id="removeBgTabCanvasGrid"></div>
        </div>
        <div id="removeBgTabPreview" class="ed-removebg-preview" hidden>

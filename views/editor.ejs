          <label><span>H</span><input type="number" id="pH" min="1" step="1"></label>
        </div>
        <div class="ed-row2">
          <label><span><%= t('ed_props_angle') %></span><input type="number" id="pAngle" step="1"></label>
          <div class="ed-btnrow">
            <button id="pFlipH" title="<%= t('ed_props_flip_h') %>">⇋</button>
            <button id="pFlipV" title="<%= t('ed_props_flip_v') %>">⇅</button>
            <button id="pLock" title="<%= t('ed_props_lock') %>">🔓</button>
          </div>
        </div>
      </div>

      <div class="ed-prop-group">
        <span class="ed-glabel"><%= t('ed_props_layer') %></span>
        <div class="ed-btnrow">
          <button data-layer="front" title="<%= t('ed_layer_front') %>">⤒</button>
          <button data-layer="forward" title="<%= t('ed_layer_forward') %>">↑</button>
          <button data-layer="backward" title="<%= t('ed_layer_backward') %>">↓</button>
          <button data-layer="back" title="<%= t('ed_layer_back') %>">⤓</button>
        </div>
        <span class="ed-glabel"><%= t('ed_props_align') %></span>
        <div class="ed-btnrow">
          <button data-canvasalign="left" title="<%= t('ed_align_left') %>">⯇</button>
          <button data-canvasalign="centerH" title="<%= t('ed_align_center_h') %>">⯀</button>
          <button data-canvasalign="right" title="<%= t('ed_align_right') %>">⯈</button>
          <button data-canvasalign="top" title="<%= t('ed_align_top') %>">⯅</button>
          <button data-canvasalign="middle" title="<%= t('ed_align_middle') %>">⯀</button>
          <button data-canvasalign="bottom" title="<%= t('ed_align_bottom') %>">⯆</button>
        </div>
        <div class="ed-btnrow ed-actions-row" id="distributeRow" hidden>
          <button id="pDistH" class="ed-wbtn" title="<%= t('ed_distribute_h') %>"><%= t('ed_distribute_h') %></button>
          <button id="pDistV" class="ed-wbtn" title="<%= t('ed_distribute_v') %>"><%= t('ed_distribute_v') %></button>
        </div>
        <div class="ed-btnrow ed-actions-row">
          <button id="pSaveSticker" class="ed-wbtn" title="<%= t('ed_save_sticker_hint') %>"><%= t('ed_save_sticker') %></button>
          <button id="pDuplicate" class="ed-wbtn"><%= t('ed_duplicate') %></button>
          <button id="pDelete" class="ed-wbtn ed-danger"><%= t('ed_delete') %></button>
        </div>
        <p class="ed-hint" id="saveStickerHint"></p>
      </div>

    </div>
  </aside>
</div>

<!-- first-visit welcome (localStorage-gated, see public/js/editor/onboard.js);
     also reachable again later via the "?" shortcuts dropdown -->
<div class="ed-onboard-backdrop" id="onboardBackdrop" hidden>
  <div class="ed-onboard-modal" role="dialog" aria-modal="true" aria-labelledby="onboardTitle">
    <h2 id="onboardTitle"><%= t('ed_onboard_title') %></h2>
    <p class="ed-onboard-sub"><%= t('ed_onboard_sub') %></p>
    <ul class="ed-onboard-list">
      <li><%- icon('tpl') %><span><%= t('ed_onboard_templates') %></span></li>
      <li><%- icon('shapes') %><span><%= t('ed_onboard_elements') %></span></li>
      <li><%- icon('upload') %><span><%= t('ed_onboard_photos') %></span></li>
      <li><%- icon('text') %><span><%= t('ed_onboard_text') %></span></li>
      <li><%- icon('download') %><span><%= t('ed_onboard_download') %></span></li>
    </ul>
    <button class="btn btn-primary ed-block" id="onboardStart"><%= t('ed_onboard_start') %></button>
  </div>
</div>

<!-- Bulk Create: generate many pages from one CSV, one per row, by mapping
     CSV columns onto the text layers of the current page -->
<div class="ed-onboard-backdrop" id="bulkBackdrop" hidden>
  <div class="ed-onboard-modal ed-bulk-modal" role="dialog" aria-modal="true" aria-labelledby="bulkTitle">
    <h2 id="bulkTitle"><%= t('ed_bulk') %></h2>
    <p class="ed-onboard-sub"><%= t('ed_bulk_desc') %></p>

    <label class="ed-bulk-label"><%= t('ed_bulk_csv_label') %></label>
    <textarea id="bulkCsv" class="ed-bulk-textarea" rows="5" placeholder="<%= t('ed_bulk_csv_placeholder') %>"></textarea>
    <div class="ed-bulk-csv-row">
      <label class="btn btn-ghost btn-sm" for="bulkCsvFile"><%= t('ed_bulk_csv_upload') %></label>
      <input type="file" id="bulkCsvFile" accept=".csv,text/csv" hidden>
      <span class="ed-hint" id="bulkCsvSummary"></span>
    </div>

    <div id="bulkFieldsWrap" hidden>
      <label class="ed-bulk-label"><%= t('ed_bulk_fields_label') %></label>
      <div id="bulkFields" class="ed-bulk-fields"></div>
    </div>
    <p class="ed-hint" id="bulkNoFields" hidden><%= t('ed_bulk_no_fields') %></p>

    <div class="ed-bulk-actions">
      <button class="btn btn-ghost btn-sm" id="bulkCancel"><%= t('common_cancel') %></button>
      <button class="btn btn-primary btn-sm" id="bulkGenerate" disabled><%= t('ed_bulk_generate') %></button>
    </div>
    <p class="ed-hint" id="bulkHint"></p>
  </div>
</div>

<div class="ed-ctxmenu" id="ctxMenu" hidden>
  <button data-ctx="duplicate"><%= t('ed_duplicate') %></button>
  <button data-ctx="front"><%= t('ed_layer_front') %></button>
  <button data-ctx="back"><%= t('ed_layer_back') %></button>
  <button data-ctx="lock"><%= t('ed_props_lock') %></button>
  <button data-ctx="delete" class="ed-danger"><%= t('ed_delete') %></button>
</div>

<!-- floating toolbar over the current selection -->
<div class="ed-floatbar" id="floatbar" hidden>
  <input type="color" id="fbColor" title="<%= t('ed_props_color') %>">
  <button id="fbBold" title="<%= t('ed_props_bold') %>"><b>B</b></button>
  <button id="fbForward" title="<%= t('ed_layer_forward') %>"><%- icon('up') %></button>
  <button id="fbBackward" title="<%= t('ed_layer_backward') %>"><%- icon('down') %></button>
  <button id="fbDup" title="<%= t('ed_duplicate') %>"><%- icon('copy') %></button>
  <button id="fbLock" title="<%= t('ed_props_lock') %>"><%- icon('unlock') %></button>
  <button id="fbDelete" class="ed-danger" title="<%= t('ed_delete') %>"><%- icon('trash') %></button>
  <button id="fbMore" class="ed-floatbar-more" title="<%= t('ed_more_options') %>" aria-label="<%= t('ed_more_options') %>">
    <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/><circle cx="15" cy="6" r="1.6" fill="currentColor" stroke="none"/><circle cx="9" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="15" cy="18" r="1.6" fill="currentColor" stroke="none"/></svg>
  </button>
</div>

<!-- crop mode bar -->
<div class="ed-cropbar" id="cropbar" hidden>
  <span><%= t('ed_img_crop') %></span>
  <button class="btn btn-primary btn-sm" id="cropApply"><%= t('ed_img_crop_apply') %></button>
  <button class="btn btn-ghost btn-sm" id="cropReset"><%= t('ed_img_crop_reset') %></button>
  <button class="btn btn-ghost btn-sm" id="cropCancel"><%= t('ed_img_crop_cancel') %></button>
</div>

<!-- freehand-select mode bar -->
<div class="ed-cropbar" id="lassobar" hidden>
  <span id="lassoHint"><%= t('ed_lasso_hint_draw') %></span>
  <button class="btn btn-primary btn-sm" id="lassoExtract" disabled><%= t('ed_lasso_extract') %></button>
  <button class="btn btn-primary btn-sm" id="lassoErase" disabled><%= t('ed_lasso_erase') %></button>
  <button class="btn btn-ghost btn-sm" id="lassoRedraw"><%= t('ed_lasso_redraw') %></button>
  <button class="btn btn-ghost btn-sm" id="lassoDone"><%= t('ed_lasso_done') %></button>
</div>

<!-- Magic Grab mode bar -->
<div class="ed-cropbar ed-magicgrabbar" id="magicgrabbar" hidden>
  <div class="ed-btnrow ed-magicgrab-modes">
    <button type="button" class="ed-wbtn" data-mggmode="foreground"><%= t('ed_magicgrab_mode_foreground') %></button>
    <button type="button" class="ed-wbtn" data-mggmode="click"><%= t('ed_magicgrab_mode_click') %></button>
    <button type="button" class="ed-wbtn" data-mggmode="brush"><%= t('ed_magicgrab_mode_brush') %></button>
  </div>
  <label class="ed-magicgrab-brush-row" id="magicgrabBrushRow" hidden>
    <span><%= t('ed_magicgrab_brush_size') %></span>
    <input type="range" id="magicgrabBrushSize" min="8" max="150" step="2" value="40">
  </label>
  <span id="magicgrabHint"></span>
  <button class="btn btn-ghost btn-sm" id="magicgrabClear" disabled><%= t('ed_magicgrab_clear') %></button>
  <button class="btn btn-primary btn-sm" id="magicgrabGrab" disabled><%= t('ed_magicgrab_grab') %></button>
  <button class="btn btn-ghost btn-sm" id="magicgrabDone"><%= t('ed_lasso_done') %></button>
</div>


          <button class="btn btn-primary btn-sm ed-block" id="mwGenerate"><%= t('ed_magicwrite_generate') %></button>
          <p class="ed-hint" id="mwHint"></p>
        </div>
        <h3><%= t('ed_props_font') %></h3>
        <div class="ed-font-list" id="fontList"></div>
      </section>

      <!-- uploads -->
      <section class="ed-panel" data-panel="uploads">
        <h3><%= t('ed_tab_uploads') %></h3>

        </div>
        <p class="ed-hint" id="decomposeTabHint"></p>
        <div class="ed-decompose-results" id="decomposeTabResults" hidden></div>
      </section>

      <!-- freehand draw -->
      <section class="ed-panel" data-panel="draw">
        <h3><%= t('ed_tab_draw') %></h3>
        <label class="ed-row"><span><%= t('ed_props_color') %></span><input type="color" id="drawColor" value="#1b1830"></label>
        <label class="ed-row"><span><%= t('ed_draw_width') %></span>
          <input type="range" id="drawWidth" min="1" max="60" step="1" value="6"><output id="drawWidthOut">6</output></label>
        <p class="ed-hint"><%= t('ed_draw_hint') %></p>
      </section>

      <!-- charts -->
      <section class="ed-panel" data-panel="charts">
        <h3><%= t('ed_tab_charts') %></h3>
        <div class="ed-btnrow ed-actions-row" id="chartTypeRow">
          <button data-charttype="bar" class="ed-wbtn on"><%= t('ed_chart_bar') %></button>
          <button data-charttype="pie" class="ed-wbtn"><%= t('ed_chart_pie') %></button>
          <button data-charttype="line" class="ed-wbtn"><%= t('ed_chart_line') %></button>
        </div>
        <span class="ed-glabel"><%= t('ed_chart_data') %></span>
        <textarea id="chartData" class="ed-ai-prompt" rows="6">Jan,30
Feb,45
Mar,20
Apr,60</textarea>
        <p class="ed-hint"><%= t('ed_chart_data_hint') %></p>
        <button class="btn btn-primary btn-sm ed-block" id="chartInsertBtn"><%= t('ed_chart_insert') %></button>
      </section>

      <!-- table -->
      <section class="ed-panel" data-panel="table">
        <h3><%= t('ed_tab_table') %></h3>
        <div class="ed-row2">
          <label><span><%= t('ed_table_rows') %></span><input type="number" id="tableRows" min="1" max="12" value="3"></label>
          <label><span><%= t('ed_table_cols') %></span><input type="number" id="tableCols" min="1" max="8" value="3"></label>
        </div>
        <button class="btn btn-primary btn-sm ed-block" id="tableInsertBtn"><%= t('ed_table_insert') %></button>
        <p class="ed-hint"><%= t('ed_table_hint') %></p>
      </section>

      <!-- QR code -->
      <section class="ed-panel" data-panel="qr">
        <h3><%= t('ed_tab_qr') %></h3>
        <textarea id="qrText" class="ed-ai-prompt" rows="3" maxlength="1000" placeholder="<%= t('ed_qr_placeholder') %>"></textarea>
        <button class="btn btn-primary btn-sm ed-block" id="qrInsertBtn"><%= t('ed_qr_insert') %></button>
        <p class="ed-hint" id="qrHint"></p>
      </section>

      <!-- layers -->
      <section class="ed-panel" data-panel="layers">
        <h3><%= t('ed_tab_layers') %></h3>
        <div class="ed-layers" id="layersList"><p class="ed-hint"><%= t('ed_layers_empty') %></p></div>
      </section>

      <!-- brand kit -->
      <section class="ed-panel" data-panel="brand">
        <h3><%= t('ed_brand_colors') %></h3>
        <div class="ed-swatches" id="brandColors"></div>
        <button class="btn btn-ghost btn-sm ed-block" id="brandAddColor"><%= t('ed_brand_add_color') %></button>
        <button class="btn btn-ghost btn-sm ed-block" id="brandExtractBtn"><%= t('ed_brand_extract') %></button>
        <input type="file" id="brandExtractInput" accept="image/png,image/jpeg,image/webp" hidden>
        <div class="ed-canvas-pick" id="brandExtractCanvasPick" hidden>
          <span class="ed-glabel"><%= t('ed_pick_from_canvas') %></span>
          <div class="ed-upload-grid" id="brandExtractCanvasGrid"></div>
        </div>
        <h3><%= t('ed_brand_fonts') %></h3>
        <label class="ed-row"><span><%= t('ed_brand_font_heading') %></span><select id="brandFontH"></select></label>
        <label class="ed-row"><span><%= t('ed_brand_font_body') %></span><select id="brandFontB"></select></label>
        <div class="ed-custom-fonts" id="customFontsList"></div>
        <label class="ed-upload-drop" id="fontUploadDrop">
          <input type="file" id="fontUploadInput" accept=".ttf,.otf,.woff,.woff2" hidden>
          <span><%= t('ed_brand_upload_font') %></span>
          <small><%= t('ed_brand_font_hint') %></small>
        </label>
        <h3><%= t('ed_brand_logo') %></h3>
        <label class="ed-upload-drop" id="brandLogoDrop">
          <input type="file" id="brandLogoInput" accept="image/png,image/jpeg,image/webp,image/svg+xml" hidden>
          <span><%= t('ed_upload_btn') %></span>
        </label>
        <div id="brandLogoPreview" class="ed-brand-logo-preview" hidden>
          <img id="brandLogoImg" src="" alt="">
          <button class="btn btn-primary btn-sm ed-block" id="brandLogoAdd"><%= t('ed_brand_logo_add') %></button>
        </div>

        <h3><%= t('ed_brand_apply_title') %></h3>
        <p class="ed-hint"><%= t('ed_brand_apply_desc') %></p>
        <button class="btn btn-primary btn-sm ed-block" id="brandApplyBtn"><%= t('ed_brand_apply_btn') %></button>
        <p class="ed-hint" id="brandApplyHint"></p>
      </section>

      <!-- background -->
      <section class="ed-panel" data-panel="background">
        <h3><%= t('ed_bg_color') %></h3>
        <div class="ed-swatches" id="bgSwatches"></div>
        <label class="ed-row"><span><%= t('ed_props_color') %></span>
          <input type="color" id="bgColorPick" value="#ffffff"></label>
        <button class="btn btn-ghost btn-sm ed-block" id="bgClear"><%= t('ed_bg_clear') %></button>
        <h3><%= t('ed_bg_image') %></h3>
        <div class="ed-upload-grid" id="bgImageGrid"><p class="ed-hint"><%= t('ed_uploads_empty') %></p></div>

        <h3><%= t('ed_bg_edit_title') %></h3>
        <p class="ed-hint"><%= t('ed_bg_edit_desc') %></p>
        <span class="ed-glabel"><%= t('ed_img_removebg') %></span>
        <div class="ed-btnrow ed-actions-row" id="bgRemoveBgRow" data-available="<%= vendorLocal.bgRemoval ? '1' : '0' %>">
          <button class="ed-wbtn" data-mode="transparent" title="<%= t('ed_img_removebg_transparent') %>"><%= t('ed_img_removebg_transparent') %></button>
          <button class="ed-wbtn" data-mode="white" title="<%= t('ed_img_removebg_white') %>"><%= t('ed_img_removebg_white') %></button>
        </div>
        <button class="btn btn-ghost btn-sm ed-block" id="bgRemoveBgImageBtn" data-mode="image"><%= t('ed_img_removebg_image') %></button>
        <input type="file" id="bgRemoveBgImageInput" accept="image/png,image/jpeg,image/webp" hidden>
        <p class="ed-hint" id="bgRemoveBgHint"></p>

        <span class="ed-glabel"><%= t('ed_img_decompose') %></span>
        <button class="btn btn-ghost btn-sm ed-block" id="bgDecomposeBtn" data-available="<%= vendorLocal.decompose ? '1' : '0' %>"><%= t('ed_img_decompose_btn') %></button>
        <p class="ed-hint" id="bgDecomposeHint"></p>
        <div class="ed-decompose-results" id="bgDecomposeResults" hidden></div>

        <span class="ed-glabel"><%= t('ed_lasso_title') %></span>
        <button class="btn btn-ghost btn-sm ed-block" id="bgLassoBtn"><%= t('ed_lasso_btn') %></button>
        <p class="ed-hint" id="bgLassoHint"></p>

        <span class="ed-glabel"><%= t('ed_magicgrab_title') %></span>
        <p class="ed-hint"><%= t('ed_magicgrab_desc') %></p>
        <button class="btn btn-primary btn-sm ed-block" id="bgMagicGrabBtn"><%= t('ed_magicgrab_btn') %></button>
        <p class="ed-hint" id="bgMagicGrabHint"></p>
      </section>
    </div>
  </aside>

  <!-- CENTER -->
  <div class="ed-workspace" id="workspace">
    <div class="ed-canvas-area" id="canvasArea">
      <canvas id="c"></canvas>
    </div>
    <div class="ed-page-strip" id="pageStrip">
      <div class="ed-page-strip-list" id="pageStripList"></div>
      <button type="button" class="ed-page-add" id="pageAddBtn" title="<%= t('ed_page_add') %>" aria-label="<%= t('ed_page_add') %>">+</button>
    </div>
  </div>

  <!-- RIGHT -->
  <aside class="ed-right" id="rightPanel">
    <button type="button" class="ed-panel-close" id="closeRightPanel" aria-label="<%= t('common_close') %>">✕</button>
    <div class="ed-props-empty" id="propsEmpty"><p class="ed-hint"><%= t('ed_no_selection') %></p></div>
    <div class="ed-props" id="props" hidden>

      <div class="ed-prop-group" id="grpText" hidden>
        <label class="ed-row"><span><%= t('ed_props_font') %></span>
          <select id="pFont"></select></label>
        <div class="ed-recent-fonts" id="recentFontsText" hidden></div>
        <div class="ed-row2">
          <label><span><%= t('ed_props_size') %></span><input type="number" id="pFontSize" min="4" max="800" step="1"></label>
          <label><span><%= t('ed_props_color') %></span><input type="color" id="pTextColor"></label>
        </div>
        <div class="ed-swatches ed-swatches-sm" id="recentColorsText" hidden></div>
        <div class="ed-btnrow">
          <button id="pBold" title="<%= t('ed_props_bold') %>"><b>B</b></button>
          <button id="pItalic" title="<%= t('ed_props_italic') %>"><i>I</i></button>
          <button id="pUnderline" title="<%= t('ed_props_underline') %>"><u>U</u></button>
          <span class="ed-sep"></span>
          <button data-align="left" title="<%= t('ed_align_left') %>">⯇</button>
          <button data-align="center" title="<%= t('ed_align_center_h') %>">≡</button>
          <button data-align="right" title="<%= t('ed_align_right') %>">⯈</button>
          <span class="ed-sep"></span>
          <button id="pDir" title="<%= t('ed_props_direction') %>">⇄</button>
        </div>
        <div class="ed-row2">
          <label><span><%= t('ed_props_line_height') %></span><input type="number" id="pLineHeight" min="0.5" max="3" step="0.05"></label>
          <label><span><%= t('ed_props_letter_spacing') %></span><input type="number" id="pCharSpacing" min="-200" max="800" step="10"></label>
        </div>
        <label class="ed-row"><span><%= t('ed_text_curve') %></span>
          <input type="range" id="pCurve" min="-150" max="150" step="5" value="0"><output id="pCurveOut">0</output></label>

        <span class="ed-glabel"><%= t('ed_fx') %></span>
        <label class="ed-row ed-fx-row"><span><input type="checkbox" id="fxShadow"> <%= t('ed_fx_shadow') %></span>
          <input type="color" id="fxShadowColor" value="#000000"></label>
        <label class="ed-row"><span><%= t('ed_fx_blur') %></span>
          <input type="range" id="fxShadowBlur" min="0" max="40" step="1"><output id="fxShadowBlurOut">6</output></label>
        <label class="ed-row ed-fx-row"><span><input type="checkbox" id="fxOutline"> <%= t('ed_fx_outline') %></span>
          <input type="color" id="fxOutlineColor" value="#ffffff"></label>
        <label class="ed-row"><span><%= t('ed_props_stroke_width') %></span>
          <input type="range" id="fxOutlineW" min="1" max="20" step="1"><output id="fxOutlineWOut">2</output></label>
        <label class="ed-row ed-fx-row"><span><input type="checkbox" id="fxHighlight"> <%= t('ed_fx_highlight') %></span>
          <input type="color" id="fxHighlightColor" value="#ffe066"></label>
      </div>

      <div class="ed-prop-group" id="grpImage" hidden>
        <span class="ed-glabel"><%= t('ed_img_filters') %></span>

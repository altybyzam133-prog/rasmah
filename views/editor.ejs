          <textarea id="mwPrompt" class="ed-mw-textarea" rows="2" placeholder="<%= t('ed_magicwrite_placeholder') %>"></textarea>
          <select id="mwTone">
            <option value="general" selected><%= t('ed_magicwrite_general') %></option>
            <option value="headline"><%= t('ed_magicwrite_headline') %></option>
            <option value="tagline"><%= t('ed_magicwrite_tagline') %></option>
            <option value="description"><%= t('ed_magicwrite_description') %></option>

<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= pageTitle %> — <%= brandName %></title>
  <link rel="stylesheet" href="/static/fonts/fonts.css">
  <link rel="stylesheet" href="/static/css/editor.css">
  <link rel="icon" type="image/svg+xml" href="/static/img/favicon.svg">
</head>
<body class="editor-body" dir="<%= dir %>">

<%
  const ICON = {
    back: '<path d="M15 18l-6-6 6-6"/>',
    undo: '<path d="M9 14 4 9l5-5"/><path d="M4 9h11a6 6 0 0 1 0 12h-3"/>',
    redo: '<path d="m15 14 5-5-5-5"/><path d="M20 9H9a6 6 0 0 0 0 12h3"/>',
    zin: '<circle cx="11" cy="11" r="7"/><path d="M11 8v6M8 11h6M21 21l-4.3-4.3"/>',
    zout: '<circle cx="11" cy="11" r="7"/><path d="M8 11h6M21 21l-4.3-4.3"/>',
    fit: '<path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3m13-5v3a2 2 0 0 1-2 2h-3"/>',
    download: '<path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/>',
    tpl: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
    shapes: '<circle cx="8" cy="8" r="5"/><path d="M14 12h7v7h-7z"/>',
    text: '<path d="M4 7V5h16v2M9 19h6M12 5v14"/>',
    upload: '<path d="M12 15V3m0 0 4 4m-4-4L8 7M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>',
    bg: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="m3 15 5-5 4 4 3-3 6 6"/><circle cx="9" cy="9" r="1.5"/>',
    layers: '<path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5M3 17l9 5 9-5"/>',
    eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>',
    eyeoff: '<path d="M9.9 4.2A9.5 9.5 0 0 1 12 4c6.5 0 10 8 10 8a18 18 0 0 1-2.3 3.3M6.7 6.7A18 18 0 0 0 2 12s3.5 8 10 8a9.5 9.5 0 0 0 4.2-1M3 3l18 18"/>',
    lock: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
    unlock: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 7.5-2"/>',
    grip: '<circle cx="9" cy="6" r="1"/><circle cx="9" cy="12" r="1"/><circle cx="9" cy="18" r="1"/><circle cx="15" cy="6" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="18" r="1"/>',
    badge: '<path d="M12 2l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17l-5.9 3 1.2-6.5L2.5 8.9 9 8z"/>',
    copy: '<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/>',
    trash: '<path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>',
    up: '<path d="M12 19V5M5 12l7-7 7 7"/>',
    down: '<path d="M12 5v14M19 12l-7 7-7-7"/>'
  };
  function icon(name, cls) {
    return '<svg class="ic ' + (cls||'') + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + ICON[name] + '</svg>';
  }
%>

<header class="ed-topbar">
  <div class="ed-top-left">
    <a class="ed-icon-btn" href="/dashboard" title="<%= t('ed_back') %>" aria-label="<%= t('ed_back') %>"><%- icon('back') %></a>
    <img class="ed-brand-logo" src="/static/img/favicon.svg" alt="">
    <input type="text" id="edTitle" class="ed-title-input" value="<%= design.title %>"
           placeholder="<%= t('ed_untitled') %>" maxlength="120" aria-label="title">
  </div>

  <div class="ed-top-center">
    <button class="ed-icon-btn" id="btnUndo" title="<%= t('ed_undo') %>" disabled><%- icon('undo') %></button>
    <button class="ed-icon-btn" id="btnRedo" title="<%= t('ed_redo') %>" disabled><%- icon('redo') %></button>
    <span class="ed-sep"></span>
    <button class="ed-icon-btn" id="btnZoomOut" title="<%= t('ed_zoom_out') %>"><%- icon('zout') %></button>
    <button class="ed-zoom-val" id="zoomVal">100%</button>
    <button class="ed-icon-btn" id="btnZoomIn" title="<%= t('ed_zoom_in') %>"><%- icon('zin') %></button>
    <button class="ed-icon-btn" id="btnFit" title="<%= t('ed_zoom_fit') %>"><%- icon('fit') %></button>
  </div>

  <div class="ed-top-right">
    <span class="ed-save-pill" id="savePill" data-t-saved="<%= t('ed_saved') %>" data-t-saving="<%= t('ed_saving') %>"
          data-t-unsaved="<%= t('ed_unsaved') %>" data-t-error="<%= t('ed_save_error') %>"><%= t('ed_saved') %></span>
    <div class="ed-dropdown" id="resizeDropdown">
      <button class="ed-icon-btn" id="btnResize" title="<%= t('ed_resize') %>" aria-label="<%= t('ed_resize') %>">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m0 8v3a2 2 0 0 0 2 2h3m8 0h3a2 2 0 0 0 2-2v-3m0-8V5a2 2 0 0 0-2-2h-3"/><path d="M9 15 15 9"/></svg>
      </button>
      <div class="ed-dropdown-menu ed-resize-menu" hidden>
        <p class="ed-share-desc"><%= t('ed_resize_desc') %></p>
        <div class="ed-resize-groups" id="resizeGroups"></div>
        <div class="ed-resize-custom">
          <label><span><%= t('ed_resize_w') %></span><input type="number" id="resizeW" min="16" max="8000" step="1"></label>
          <label><span><%= t('ed_resize_h') %></span><input type="number" id="resizeH" min="16" max="8000" step="1"></label>
        </div>
        <button class="btn btn-primary btn-sm ed-block" id="resizeApply"><%= t('ed_resize_apply') %></button>
      </div>
    </div>
    <button class="ed-icon-btn" id="btnBulk" title="<%= t('ed_bulk') %>" aria-label="<%= t('ed_bulk') %>">
      <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><path d="M10 6.5h4M6.5 10v4M17.5 10v4M10 17.5h4"/></svg>
    </button>
    <div class="ed-dropdown" id="saveTplDropdown">
      <button class="ed-icon-btn" id="btnSaveTpl" title="<%= t('ed_save_tpl') %>" aria-label="<%= t('ed_save_tpl') %>">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><path d="M17 21v-8H7v8M7 3v5h8"/></svg>
      </button>
      <div class="ed-dropdown-menu ed-savetpl-menu" hidden>
        <p class="ed-share-desc"><%= t('ed_save_tpl_desc') %></p>
        <label class="ed-savetpl-field"><span><%= t('ed_save_tpl_name') %></span>
          <input type="text" id="saveTplName" maxlength="120">
        </label>
        <button class="btn btn-primary btn-sm ed-block" id="saveTplApply"><%= t('ed_save_tpl_btn') %></button>
        <p class="ed-hint" id="saveTplHint"></p>
      </div>
    </div>
    <div class="ed-dropdown" id="shareDropdown">
      <button class="ed-icon-btn" id="btnShare" title="<%= t('ed_share') %>" aria-label="<%= t('ed_share') %>">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>
      </button>
      <div class="ed-dropdown-menu ed-share-menu" hidden>
        <p class="ed-share-desc"><%= t('ed_share_desc') %></p>
        <div class="ed-share-row">
          <input type="text" id="shareUrl" readonly placeholder="—">
          <button class="btn btn-primary btn-sm" id="shareCopy"><%= t('ed_share_copy') %></button>
        </div>
        <button class="btn btn-ghost btn-sm ed-block" id="shareCreate"><%= t('ed_share_create') %></button>
        <button class="ed-share-disable" id="shareDisable" hidden><%= t('ed_share_disable') %></button>
      </div>
    </div>
    <div class="ed-dropdown" id="historyDropdown">
      <button class="ed-icon-btn" id="btnHistory" title="<%= t('ed_history') %>" aria-label="<%= t('ed_history') %>">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/><path d="M3.5 9.5A9 9 0 1 1 3 12"/><path d="M3 5v4h4"/></svg>
      </button>
      <div class="ed-dropdown-menu ed-history-menu" hidden>
        <p class="ed-share-desc"><%= t('ed_history_desc') %></p>
        <div id="historyList" class="ed-history-list"></div>
      </div>
    </div>
    <button class="btn btn-ghost btn-sm" id="btnPresent">
      <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 20 12 6 21 6 3"/></svg>
      <span><%= t('ed_present') %></span>
    </button>
    <div class="ed-dropdown" id="dlDropdown">
      <button class="btn btn-primary btn-sm" id="btnDownload"><%- icon('download') %> <span class="dl-btn-text"><%= t('ed_download') %></span></button>
      <div class="ed-dropdown-menu" hidden>
        <button data-fmt="png"><%= t('ed_download_png') %></button>
        <button data-fmt="jpg"><%= t('ed_download_jpg') %></button>
        <button data-fmt="pdf"><%= t('ed_download_pdf') %></button>
        <button data-fmt="svg"><%= t('ed_download_svg') %></button>
        <button data-fmt="gif" id="dlGifBtn"<%= vendorLocal.gif ? '' : ' disabled title="' + t('ed_download_gif_unavailable') + '"' %>><%= t('ed_download_gif') %></button>
        <label class="ed-dd-check"><input type="checkbox" id="dlTransparent"> <%= t('ed_download_transparent') %></label>
        <label class="ed-dd-row"><%= t('ed_download_scale') %>
          <select id="dlScale"><option value="1">×1</option><option value="2" selected>×2</option><option value="3">×3</option></select>
        </label>
        <label class="ed-dd-check" id="dlAllPagesRow" hidden><input type="checkbox" id="dlAllPages"> <%= t('ed_download_all_pages') %></label>
        <p class="ed-hint" id="dlGifHint" hidden><%= t('ed_download_gif_pages_hint') %></p>
      </div>
    </div>
    <div class="ed-dropdown" id="shortcutsDropdown">
      <button class="ed-icon-btn" id="btnShortcuts" title="<%= t('ed_shortcuts') %>" aria-label="<%= t('ed_shortcuts') %>">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.83 1c0 2-3 2-3 4"/><path d="M12 17h.01"/></svg>
      </button>
      <div class="ed-dropdown-menu ed-shortcuts-menu" hidden>
        <p class="ed-share-desc"><%= t('ed_shortcuts_desc') %></p>
        <div class="ed-shortcut-list">
          <% [
            ['Ctrl/⌘ + S', 'ed_sc_save'], ['Ctrl/⌘ + Z', 'ed_sc_undo'], ['Ctrl/⌘ + Shift + Z', 'ed_sc_redo'],
            ['Ctrl/⌘ + D', 'ed_sc_duplicate'], ['Alt + ' + t('ed_sc_drag'), 'ed_sc_duplicate_drag'],
            ['Ctrl/⌘ + C', 'ed_sc_copy'], ['Ctrl/⌘ + V', 'ed_sc_paste'], ['Ctrl/⌘ + A', 'ed_sc_select_all'],
            ['Ctrl/⌘ + G', 'ed_sc_group'], ['Ctrl/⌘ + Shift + G', 'ed_sc_ungroup'],
            ['Delete', 'ed_sc_delete'], ['Escape', 'ed_sc_deselect'],
            [t('ed_sc_arrows'), 'ed_sc_nudge'], ['Shift + ' + t('ed_sc_arrows'), 'ed_sc_nudge_big'],
            ['+ / -', 'ed_sc_zoom'], ['0', 'ed_sc_zoom_reset'], ['F', 'ed_sc_zoom_fit'],
            ['Ctrl/⌘ + ' + t('ed_sc_scroll'), 'ed_sc_zoom_scroll'], [t('ed_sc_space_drag'), 'ed_sc_pan'],
            [t('ed_sc_right_click'), 'ed_sc_context_menu'], ['Shift + ' + t('ed_sc_rotate'), 'ed_sc_rotate_snap'],
          ].forEach(function(row) { %>
            <div class="ed-shortcut-row"><kbd><%= row[0] %></kbd><span><%= t(row[1]) %></span></div>
          <% }); %>
        </div>
        <button class="btn btn-ghost btn-sm ed-block" id="onboardReplay"><%= t('ed_onboard_replay') %></button>
      </div>
    </div>
    <a class="lang-switch" href="<%= switchLangUrl %>"><%= t('switch_to') %></a>
  </div>
</header>

<div class="ed-main">
  <!-- LEFT -->
  <aside class="ed-left">
    <nav class="ed-tabs" role="tablist">
      <button class="ed-tab active" data-tab="templates" title="<%= t('ed_tab_templates') %>"><%- icon('tpl') %><span><%= t('ed_tab_templates') %></span></button>
      <button class="ed-tab" data-tab="elements" title="<%= t('ed_tab_elements') %>"><%- icon('shapes') %><span><%= t('ed_tab_elements') %></span></button>
      <button class="ed-tab" data-tab="text" title="<%= t('ed_tab_text') %>"><%- icon('text') %><span><%= t('ed_tab_text') %></span></button>
      <button class="ed-tab" data-tab="uploads" title="<%= t('ed_tab_uploads') %>"><%- icon('upload') %><span><%= t('ed_tab_uploads') %></span></button>
      <button class="ed-tab" data-tab="stock" title="<%= t('ed_tab_stock') %>">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg>
        <span><%= t('ed_tab_stock') %></span>
      </button>
      <button class="ed-tab" data-tab="removebg" title="<%= t('ed_tab_removebg') %>">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4 8.12 15.88M14.47 14.48 20 20M8.12 8.12 12 12"/></svg>
        <span><%= t('ed_tab_removebg') %></span>
      </button>
      <button class="ed-tab" data-tab="decompose" title="<%= t('ed_tab_decompose') %>">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><path d="M14 5h4a2 2 0 0 1 2 2v4M10 19H6a2 2 0 0 1-2-2v-4"/></svg>
        <span><%= t('ed_tab_decompose') %></span>
      </button>
      <button class="ed-tab" data-tab="ai" title="<%= t('ed_tab_ai') %>">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8"/></svg>
        <span><%= t('ed_tab_ai') %></span>
      </button>
      <button class="ed-tab" data-tab="draw" title="<%= t('ed_tab_draw') %>">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        <span><%= t('ed_tab_draw') %></span>
      </button>
      <button class="ed-tab" data-tab="charts" title="<%= t('ed_tab_charts') %>">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6"/><rect x="12" y="8" width="3" height="10"/><rect x="17" y="5" width="3" height="13"/></svg>
        <span><%= t('ed_tab_charts') %></span>
      </button>
      <button class="ed-tab" data-tab="table" title="<%= t('ed_tab_table') %>">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="1"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/></svg>
        <span><%= t('ed_tab_table') %></span>
      </button>
      <button class="ed-tab" data-tab="qr" title="<%= t('ed_tab_qr') %>">
        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h3v3h-3zM20 14v3M14 20h3M20 20v.01"/></svg>
        <span><%= t('ed_tab_qr') %></span>
      </button>
      <button class="ed-tab" data-tab="background" title="<%= t('ed_tab_background') %>"><%- icon('bg') %><span><%= t('ed_tab_background') %></span></button>
      <button class="ed-tab" data-tab="layers" title="<%= t('ed_tab_layers') %>"><%- icon('layers') %><span><%= t('ed_tab_layers') %></span></button>
      <button class="ed-tab" data-tab="brand" title="<%= t('ed_tab_brand') %>"><%- icon('badge') %><span><%= t('ed_tab_brand') %></span></button>
    </nav>

    <div class="ed-panels">
      <button type="button" class="ed-panel-close" id="closeLeftPanel" aria-label="<%= t('common_close') %>">✕</button>
      <!-- templates -->
      <section class="ed-panel active" data-panel="templates">
        <h3><%= t('ed_tab_templates') %></h3>
        <input type="search" class="ed-search" id="tplSearch" placeholder="<%= t('ed_tpl_search') %>">
        <div class="ed-el-filters" id="tplFilters"></div>
        <div class="ed-tpl-list" id="tplList"><p class="ed-hint"><%= t('common_loading') %></p></div>
      </section>

      <!-- elements -->
      <section class="ed-panel" data-panel="elements">
        <h3><%= t('ed_shapes') %></h3>
        <div class="ed-shape-grid">
          <button data-shape="rect" title="<%= t('ed_shape_rect') %>"><span class="sh sh-rect"></span></button>
          <button data-shape="rounded" title="<%= t('ed_shape_rounded') %>"><span class="sh sh-rounded"></span></button>
          <button data-shape="circle" title="<%= t('ed_shape_circle') %>"><span class="sh sh-circle"></span></button>
          <button data-shape="ellipse" title="<%= t('ed_shape_ellipse') %>"><span class="sh sh-ellipse"></span></button>
          <button data-shape="triangle" title="<%= t('ed_shape_triangle') %>"><span class="sh sh-triangle"></span></button>
          <button data-shape="line" title="<%= t('ed_shape_line') %>"><span class="sh sh-line"></span></button>
          <button data-shape="arrow" title="<%= t('ed_shape_arrow') %>"><span class="sh sh-arrow">→</span></button>
          <button data-shape="star" title="<%= t('ed_shape_star') %>"><span class="sh sh-star">★</span></button>
        </div>

        <h3><%= t('ed_frames') %></h3>
        <p class="ed-hint"><%= t('ed_frames_hint') %></p>
        <div class="ed-shape-grid">
          <button data-frame="rect" title="<%= t('ed_shape_rect') %>"><span class="sh sh-rect"></span></button>
          <button data-frame="rounded" title="<%= t('ed_shape_rounded') %>"><span class="sh sh-rounded"></span></button>
          <button data-frame="circle" title="<%= t('ed_shape_circle') %>"><span class="sh sh-circle"></span></button>
          <button data-frame="star" title="<%= t('ed_shape_star') %>"><span class="sh sh-star">★</span></button>
        </div>

        <h3><%= t('ed_grids') %></h3>
        <p class="ed-hint"><%= t('ed_grids_hint') %></p>
        <div class="ed-shape-grid">
          <button data-grid="2col" title="<%= t('ed_grid_2col') %>">
            <svg class="ic" viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="3" width="9" height="18"/><rect x="13" y="3" width="9" height="18"/></svg>
          </button>
          <button data-grid="2row" title="<%= t('ed_grid_2row') %>">
            <svg class="ic" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="2" width="18" height="9"/><rect x="3" y="13" width="18" height="9"/></svg>
          </button>
          <button data-grid="grid4" title="<%= t('ed_grid_4') %>">
            <svg class="ic" viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="2" width="9" height="9"/><rect x="13" y="2" width="9" height="9"/><rect x="2" y="13" width="9" height="9"/><rect x="13" y="13" width="9" height="9"/></svg>
          </button>
          <button data-grid="big2" title="<%= t('ed_grid_big2') %>">
            <svg class="ic" viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="2" width="13" height="20"/><rect x="17" y="2" width="5" height="9"/><rect x="17" y="13" width="5" height="9"/></svg>
          </button>
        </div>

        <h3><%= t('ed_el_lib') %></h3>
        <input type="search" class="ed-search" id="elSearch" placeholder="<%= t('ed_el_search') %>">

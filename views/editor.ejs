        <p class="ed-hint" id="aiGenerateHint"></p>
        <div class="ed-upload-grid" id="aiResultGrid"></div>
      </section>

      <!-- decompose elements (standalone: upload a photo, break it into pieces) -->
      <section class="ed-panel" data-panel="decompose">
        <h3><%= t('ed_tab_decompose') %></h3>
        <label class="ed-upload-drop" id="decomposeTabDrop">
          <input type="file" id="decomposeTabInput" accept="image/png,image/jpeg,image/webp" hidden>
          <span><%- icon('upload') %> <%= t('ed_upload_btn') %></span>
          <small><%= t('ed_upload_hint', { mb: config.maxUploadMb }) %></small>
        </label>
        <div class="ed-canvas-pick" id="decomposeTabCanvasPick" hidden>
          <span class="ed-glabel"><%= t('ed_pick_from_canvas') %></span>
          <div class="ed-upload-grid" id="decomposeTabCanvasGrid"></div>
        </div>
        <div id="decomposeTabPreview" class="ed-removebg-preview" hidden>
          <img id="decomposeTabImg" src="" alt="">

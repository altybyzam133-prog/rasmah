          <input type="search" class="ed-search" id="stockSearch" placeholder="<%= t('ed_stock_search') %>">
          <div class="ed-upload-grid" id="stockGrid"><p class="ed-hint"><%= t('ed_stock_hint') %></p></div>
          <button class="btn btn-ghost btn-sm ed-block" id="stockMoreBtn" hidden><%= t('ed_stock_more') %></button>
        <% } else { %>
          <p class="ed-hint"><%= t('ed_stock_unavailable') %></p>
        <% } %>

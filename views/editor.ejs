        <button class="btn btn-ghost btn-sm ed-block" id="lassoBtn"><%= t('ed_lasso_btn') %></button>

        <span class="ed-glabel"><%= t('ed_magicgrab_title') %></span>
        <p class="ed-hint"><%= t('ed_magicgrab_desc') %></p>
        <button class="btn btn-primary btn-sm ed-block" id="magicGrabBtn"><%= t('ed_magicgrab_btn') %></button>

          <button data-preset="bw"><%= t('ed_filter_bw') %></button>
          <button data-preset="vivid"><%= t('ed_filter_vivid') %></button>
          <button data-preset="warm"><%= t('ed_filter_warm') %></button>
          <button data-preset="cool"><%= t('ed_filter_cool') %></button>
          <button data-preset="fade"><%= t('ed_filter_fade') %></button>
          <button data-preset="vintage"><%= t('ed_filter_vintage') %></button>
          <button data-preset="dramatic"><%= t('ed_filter_dramatic') %></button>
        </div>
        <span class="ed-glabel"><%= t('ed_img') %></span>
        <label class="ed-row"><span><%= t('ed_img_brightness') %></span>
          <input type="range" id="imgBright" min="-0.5" max="0.5" step="0.02" value="0"></label>
        <label class="ed-row"><span><%= t('ed_img_contrast') %></span>
          <input type="range" id="imgContrast" min="-0.5" max="0.5" step="0.02" value="0"></label>
        <label class="ed-row"><span><%= t('ed_img_saturation') %></span>
          <input type="range" id="imgSat" min="-1" max="1" step="0.04" value="0"></label>
        <label class="ed-row"><span><%= t('ed_img_blur') %></span>
          <input type="range" id="imgBlur" min="0" max="0.5" step="0.02" value="0"></label>
        <label class="ed-row"><span><input type="checkbox" id="imgGray"> <%= t('ed_img_grayscale') %></span></label>
        <div class="ed-btnrow ed-actions-row">
          <button id="imgCrop" class="ed-wbtn"><%= t('ed_img_crop') %></button>
          <button id="imgReset" class="ed-wbtn"><%= t('ed_img_reset') %></button>
        </div>
        <span class="ed-glabel"><%= t('ed_img_removebg') %></span>
        <div class="ed-btnrow ed-actions-row" id="removeBgRow" data-available="<%= vendorLocal.bgRemoval ? '1' : '0' %>">
          <button class="ed-wbtn" data-mode="transparent" title="<%= t('ed_img_removebg_transparent') %>"><%= t('ed_img_removebg_transparent') %></button>
          <button class="ed-wbtn" data-mode="white" title="<%= t('ed_img_removebg_white') %>"><%= t('ed_img_removebg_white') %></button>
        </div>
        <button class="btn btn-ghost btn-sm ed-block" id="removeBgImageBtn" data-mode="image"><%= t('ed_img_removebg_image') %></button>
        <input type="file" id="removeBgImageInput" accept="image/png,image/jpeg,image/webp" hidden>


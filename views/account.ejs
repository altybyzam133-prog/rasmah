<%- include('partials/head', { pageTitle: pageTitle }) %>
<%- include('partials/header') %>

<section class="wrap account">
  <h1><%= t('acc_title') %></h1>

  <% if (ok) { %><p class="form-ok"><%= ok %></p><% } %>
  <% if (error) { %><p class="form-error"><%= error %></p><% } %>

  <div class="acc-grid">
    <div class="acc-card">
      <h2><%= t('acc_profile') %></h2>
      <form method="post" action="/account/profile" class="form">
        <%- include('partials/csrf') %>
        <label class="field"><span><%= t('auth_name') %></span>
          <input type="text" name="name" value="<%= user.name %>" required maxlength="60"></label>
        <label class="field"><span><%= t('auth_email') %></span>
          <input type="email" name="email" value="<%= user.email %>" required></label>
        <button class="btn btn-primary"><%= t('acc_save') %></button>
      </form>
    </div>

    <div class="acc-card">
      <h2><%= t('acc_password') %></h2>
      <form method="post" action="/account/password" class="form">
        <%- include('partials/csrf') %>
        <label class="field"><span><%= t('acc_current_password') %></span>
          <input type="password" name="current" required autocomplete="current-password"></label>
        <label class="field"><span><%= t('acc_new_password') %></span>
          <input type="password" name="next" required minlength="8" autocomplete="new-password"></label>
        <button class="btn btn-primary"><%= t('acc_save') %></button>
      </form>
    </div>

    <div class="acc-card">
      <h2><%= t('acc_language') %></h2>
      <form method="post" action="/account/language" class="form">
        <%- include('partials/csrf') %>
        <label class="field"><span><%= t('acc_language') %></span>
          <select name="lang">
            <option value="ar" <%= (user.lang || lang) === 'ar' ? 'selected' : '' %>>العربية</option>
            <option value="en" <%= (user.lang || lang) === 'en' ? 'selected' : '' %>>English</option>
          </select></label>
        <button class="btn btn-primary"><%= t('acc_save') %></button>
      </form>
    </div>

    <div class="acc-card">
      <h2><%= t('acc_stats') %></h2>
      <ul class="acc-stats">
        <li><b><%= counts.designs %></b> <%= t('acc_stat_designs') %></li>
        <li><b><%= counts.uploads %></b> <%= t('acc_stat_uploads') %></li>
        <li><b><%= (counts.storage / 1048576).toFixed(1) %></b> MB <%= t('acc_stat_storage') %></li>
      </ul>
    </div>
  </div>

  <div class="acc-card acc-danger">
    <h2><%= t('acc_danger') %></h2>
    <p class="muted"><%= t('acc_delete_hint') %></p>
    <form method="post" action="/account/delete" class="form-inline"
          onsubmit="return confirm('<%= t('acc_delete_confirm') %>')">
      <%- include('partials/csrf') %>
      <input type="password" name="password" placeholder="<%= t('auth_password') %>" required>
      <button class="btn btn-danger"><%= t('acc_delete') %></button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>

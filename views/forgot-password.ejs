<%- include('partials/head', { pageTitle: pageTitle }) %>
<%- include('partials/header') %>

<section class="auth-wrap">
  <div class="auth-card">
    <h1><%= t('auth_forgot_title') %></h1>
    <% if (error) { %><p class="form-error"><%= error %></p><% } %>

    <% if (!sent) { %>
      <p class="muted auth-hint"><%= t('auth_forgot_hint') %></p>
      <form method="post" action="/forgot-password" class="form">
        <%- include('partials/csrf') %>
        <label class="field">
          <span><%= t('auth_email') %></span>
          <input type="email" name="email" value="<%= values.email || '' %>" required autocomplete="email" autofocus>
        </label>
        <button type="submit" class="btn btn-primary btn-block"><%= t('auth_forgot_send') %></button>
      </form>
    <% } else { %>
      <p class="muted auth-hint"><%= t('auth_forgot_sent', { email: values.email || '' }) %></p>
      <form method="post" action="/reset-password" class="form">
        <%- include('partials/csrf') %>
        <input type="hidden" name="email" value="<%= values.email || '' %>">
        <label class="field">
          <span><%= t('auth_reset_code') %></span>
          <input type="text" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus autocomplete="one-time-code">
        </label>
        <label class="field">
          <span><%= t('auth_reset_new') %></span>
          <input type="password" name="password" required minlength="8" autocomplete="new-password">
        </label>
        <label class="field">
          <span><%= t('auth_reset_confirm') %></span>
          <input type="password" name="password2" required minlength="8" autocomplete="new-password">
        </label>
        <button type="submit" class="btn btn-primary btn-block"><%= t('auth_reset_btn') %></button>
      </form>
      <p class="auth-alt"><a href="/forgot-password"><%= t('auth_forgot_resend') %></a></p>
    <% } %>

    <p class="auth-alt"><a href="/login"><%= t('auth_to_login') %></a></p>
  </div>
</section>

<%- include('partials/footer') %>
